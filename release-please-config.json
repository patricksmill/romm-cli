{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    }
  ],
  "packages": {
    "romm-api": {
      "release-type": "rust",
      "component": "romm-api",
      "changelog-path": "romm-api/CHANGELOG.md",
      "include-component-in-tag": true
    },
    "romm-cli": {
      "release-type": "rust",
      "component": "romm-cli",
      "changelog-path": "romm-cli/CHANGELOG.md",
      "include-component-in-tag": true
    },
    "romm-tui": {
      "release-type": "rust",
      "component": "romm-tui",
      "changelog-path": "romm-tui/CHANGELOG.md",
      "include-component-in-tag": true
    }
  }
}
