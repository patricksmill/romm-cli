# Cargo (workspace target + custom CARGO_TARGET_DIR e.g. when default target/ is locked)
/target/
/target-*/

# Git worktrees (isolated feature branches)
/.worktrees/
/worktrees/

# Local env and editor
.env
/.cursor

# App runtime artifacts (local dev)
romm-cache.json
/downloads
/cache
/.docs-cache

# Android (Kotlin/Compose + cargo-ndk; see docs/plans/2026-06-06-android-frontend-design.md)
/android/.gradle/
/android/**/build/
/android/local.properties
/android/.idea/
/android/**/*.iml
/android/**/captures/
/android/**/.externalNativeBuild/
/android/**/.cxx/
/android/**/jniLibs/**/*.so
*.apk
*.aab

# UniFFI / bindgen scratch (regenerate during Android builds)
/.uniffi-bindgen/
